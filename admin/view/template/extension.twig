{#
    $Project: Ka Theme Colors $
    Settings page: tabs Colors (colors grouped by page blocks), Custom CSS and Custom Javascript.
    Colors tab: Each row: color picker + hex input + reset button + description.
#}
{% extends '@ka_common/pages/settings.twig' %}

{% block settings_page_contents %}
	{# settings_contents of the parent template is inside an embed and cannot be overridden from here, so the card is rebuilt #}
	{% embed '@ka_common/card.twig' with {'header': t('Extension Settings'), icon:'fa-palette'} %}
		{% block contents %}
<form action="{{ action_save }}" method="post" id="form-settings" data-oc-toggle="ajax">
	<p class="text-muted"><i class="fa-solid fa-circle-info"></i> {{ t('txt_save_notice') }}</p>
	<ul class="nav nav-tabs" role="tablist">
		<li class="nav-item"><a href="#tab-colors" data-bs-toggle="tab" class="nav-link active">{{ t('txt_tab_colors') }}</a></li>
		<li class="nav-item"><a href="#tab-custom-css" data-bs-toggle="tab" class="nav-link">{{ t('txt_tab_custom_css') }}</a></li>
		<li class="nav-item"><a href="#tab-custom-js" data-bs-toggle="tab" class="nav-link">{{ t('txt_tab_custom_js') }}</a></li>
	</ul>
	<div class="tab-content">
	<div class="tab-pane active" id="tab-colors">
	{% for group, codes in color_groups %}
		<h5 class="mt-4 mb-3 border-bottom pb-2">{{ t('txt_group_' ~ group) }}</h5>
		{% for code in codes %}
			{% set f = fields[code] %}
			<div class="row mb-3 ka-theme-color" data-ka-id="field-{{ code }}">
				<label class="col-sm-3 col-form-label" for="input-{{ code }}">{{ t('txt_title_' ~ code) }}</label>
				<div class="col-sm-9">
					<div class="input-group" style="max-width: 330px;">
						<input type="color" class="form-control form-control-color ka-color-picker" value="{{ f.value ?: auto_values[code]|default('#000000') }}" data-target="input-{{ code }}" title="{{ t('txt_title_' ~ code) }}" style="max-width: 60px;" />
						<input type="text" name="{{ code }}" id="input-{{ code }}" value="{{ f.value }}" maxlength="7"
							class="form-control font-monospace ka-color-hex" {% if f.default_value == '' %}placeholder="{{ t('txt_auto') }}"{% endif %} />
						<button type="button" class="btn btn-outline-secondary ka-color-reset" data-target="input-{{ code }}" data-default="{{ f.default_value }}" data-auto="{{ auto_values[code] }}"
							data-bs-toggle="tooltip" title="{{ t('txt_reset') }}: {{ f.default_value ?: t('txt_auto') }}"><i class="fa-solid fa-rotate-left"></i></button>
					</div>
					<div id="error-{{ code|replace({'_': '-'}) }}" class="invalid-feedback"></div>
					<div class="form-text">{{ t('txt_tooltip_' ~ code) }}</div>
				</div>
			</div>
		{% endfor %}
	{% endfor %}
	</div>
	{% for tab, code in {'custom-css': 'ka_theme_colors_custom_css', 'custom-js': 'ka_theme_colors_custom_js'} %}
	<div class="tab-pane" id="tab-{{ tab }}">
		<div class="mt-3" data-ka-id="field-{{ code }}">
			<label class="form-label" for="input-{{ code }}">{{ t('txt_title_' ~ code) }}</label>
			{# the value is stored html-escaped by OpenCart, the browser shows the original text in the textarea #}
			<textarea name="{{ code }}" id="input-{{ code }}" rows="20" spellcheck="false" class="form-control font-monospace">{{ fields[code].value }}</textarea>
			<div id="error-{{ code|replace({'_': '-'}) }}" class="invalid-feedback"></div>
			<div class="form-text">{{ t('txt_tooltip_' ~ code) }}</div>
		</div>
	</div>
	{% endfor %}
	</div>
</form>
		{% endblock %}
	{% endembed %}
{% endblock %}
